# Virtual GM – environment template
# Copy to .env and fill in values. Do not commit .env.
# For Docker: docker-compose.yml loads .env.docker then .env.development (gitignored).
# Put secrets in .env.development; keep .env.docker for non-secret overrides only.

# ---------- Backend ----------
# Runtime: development | production
ENV=development

# Logging: DEBUG | INFO | WARNING | ERROR
LOGURU_LEVEL=INFO

# Logfire (optional): set LOGFIRE_TOKEN to enable observability
# LOGFIRE_TOKEN=
# LOGFIRE_ENVIRONMENT=development

# LLM API keys (set one or more depending on which provider you use)
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=

# ---------- Narration text-to-speech (backend only) ----------
# Uses OPENROUTER_API_KEY above. The key stays server-side; the browser never sees it.
# Model and voice are server-configured — the browser cannot override either.
# Changing either invalidates the recorded fidelity approval and the audio cache keys.
# TTS_MODEL=deepgram/aura-2
# TTS_VOICE=aura-2-orion-en
#
# Process-local spend/abuse safeguards. The narration audio routes are
# unauthenticated like the rest of the backend, so these are a local/LAN
# guardrail — not a public-deployment security boundary.
# TTS_MAX_INPUT_CHARS=2000
# TTS_MAX_CALLS_PER_MINUTE=20
# TTS_MAX_CALLS_PER_HOUR=120
#
# Per-stream ceilings; exceeding either stops the stream and skips caching.
# TTS_MAX_STREAM_BYTES=5242880
# TTS_STREAM_TIMEOUT_SECONDS=180
#
# Best-effort local MP3 cache (backend/.cache/tts by default, git-ignored).
# Pruned by age then size at startup and after each completed stream.
# TTS_CACHE_DIR=
# TTS_CACHE_MAX_AGE_DAYS=7
# TTS_MAX_CACHE_BYTES=104857600

# ---------- Supabase (backend only) ----------
# Use in root .env.development or .env.docker — never commit real keys.
# Secret key (sb_secret_...) or legacy service_role: server-side only, bypasses RLS.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ---------- Frontend (Vite) ----------
# Backend API base URL (used when frontend calls the API)
# Default for local dev: http://localhost:8000
# On a physical device, use host machine IP, e.g. http://192.168.1.10:8000
# VITE_API_URL=http://localhost:8000
